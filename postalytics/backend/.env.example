# ─── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postalytics:postalytics@localhost:5432/postalytics_db

# ─── Authentification JWT ──────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── LLM (Phase 4 — à renseigner quand le choix est confirmé) ─────────────────
# OpenAI
OPENAI_API_KEY=
# ou Mistral
MISTRAL_API_KEY=

# ─── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
